# انسخ هذا الملف إلى .env قبل أول تشغيل:  copy .env.example .env
# ولا تشارك ملف .env — مستبعد من Git.

POSTGRES_DB=nabd
POSTGRES_USER=nabd
POSTGRES_PASSWORD=change-this-to-a-strong-password

# منفذ اللوحة على المضيف (الداخل 8080 دائماً)
NABD_PORT=8080

# أسرار اختيارية؛ اتركها فارغة واضبطها لاحقاً من اللوحة العربية
NABD_TELEGRAM_TOKEN=
NABD_DASH_PASSWORD=
NABD_SMTP_PASSWORD=
